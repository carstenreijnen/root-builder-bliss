    "tools": [
      {
        "name": "list_yachts",
        "title": "List yachts",
        "description": "List yachts in the Royal Yachts Miami fleet with size, capacity and pricing.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "featured_only": {
              "description": "Only return yachts flagged as featured.",
              "type": "boolean"
            },
            "limit": {
              "description": "Max rows to return (default 20).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_experiences",
        "title": "List experiences and add-ons",
        "description": "List charter experience packages and optional add-ons offered by Royal Yachts Miami.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "kind": {
              "description": "Which catalog to return. Defaults to both.",
              "type": "string",
              "enum": [
                "packages",
                "addons",
                "both"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_testimonials",
